# Leave empty for the fully local, traceable fallback mode.
DASHSCOPE_API_KEY=
USE_LLM=true
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# `hash` is deterministic and works offline; use `qwen` after setting the key.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-v2
VECTOR_COLLECTION=history_events_v1
VECTOR_MAX_DISTANCE=0.65

RETRIEVAL_LIMIT=5
LOG_LEVEL=INFO

# Public demo protection. Keep false for local development.
PUBLIC_DEMO_MODE=false
DEMO_LLM_REQUESTS_PER_MINUTE=6
DEMO_HARD_REQUESTS_PER_MINUTE=30
DEMO_MAX_LLM_CONCURRENCY=2
DEMO_DAILY_TOKEN_BUDGET=50000
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=500
RUNTIME_DIR=storage/runtime

# Replace this value in the deployment platform; never commit the production salt.
CLIENT_HASH_SALT=replace-with-a-random-deployment-secret

# Docker/Space platforms inject PORT; 7860 is the default.
PORT=7860
